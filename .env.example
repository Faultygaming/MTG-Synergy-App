# SQLite file lives in repo-root /data by default; change if you'd rather
# use Postgres later. Prisma resolves relative file: paths relative to the
# schema file (prisma/schema.prisma), so this is ../data/synergy.db from there.
DATABASE_URL="file:../data/synergy.db"

# Required by Scryfall: identify your client per https://scryfall.com/docs/api
SCRYFALL_USER_AGENT="MTGSynergyMap/0.1 (local-dev)"
