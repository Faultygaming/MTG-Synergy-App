{
  "name": "mtg-synergy-map",
  "version": "0.1.0",
  "private": true,
  "description": "Word-map style synergy explorer and deck builder for Magic: The Gathering",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "preinstall": "node scripts/check-package-manager.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed": "tsx scripts/seed-fixtures.ts",
    "ingest": "tsx scripts/ingest-scryfall.ts",
    "ingest:tags": "tsx scripts/ingest-oracle-tags.ts"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "clsx": "^2.1.1",
    "cytoscape": "^3.30.4",
    "cytoscape-cose-bilkent": "^4.1.0",
    "next": "14.2.18",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-cytoscapejs": "^2.0.0",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.21.8",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-cytoscapejs": "^1.2.5",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
