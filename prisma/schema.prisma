// Schema for MTG Synergy Map.
// SQLite for local-first dev; swap provider + DATABASE_URL for Postgres later.

// Prisma 7 moved the `url` out of schema files; see prisma.config.ts for
// the migrate-time datasource URL and src/lib/db.ts for the runtime adapter.
// `previewFeatures = ["driverAdapters"]` is no longer required — driver
// adapters became GA in 7.x.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// One row per unique oracle card (a "card" across all printings).
model Card {
  id              String   @id              // Scryfall oracle_id
  name            String   @unique
  manaCost        String?
  cmc             Float?
  typeLine        String
  oracleText      String?
  colors          String                    // JSON array, e.g. ["R","W"]
  colorIdentity   String                    // JSON array
  power           String?
  toughness       String?
  // Keywords extracted by lib/synergy/keywords.ts: union of Scryfall's
  // printed keywords, tribe/type tokens, regex-pack matches, and
  // (when ingested) Scryfall oracle tags from `oracleTagsJson`.
  keywordsJson    String                    // JSON array of normalized keyword strings
  // Scryfall oracle tags ("otag:ramp", "synergy-graveyard", ...) attached
  // to this card. Populated by `pnpm ingest:tags`; empty until then.
  oracleTagsJson  String   @default("[]")
  // Scryfall's produced_mana field, persisted so reextract / audit
  // paths can recompute mana-fixing / mana-rock without re-fetching
  // from the network. JSON array of color letters: ["W","U","B","R","G","C"].
  // Empty for cards that don't produce mana. Existing rows default to
  // "[]" until the next `ingest --force` repopulates them.
  producedManaJson String  @default("[]")
  imageSmall      String?
  imageNormal     String?
  scryfallUri     String?
  edhrecRank      Int?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  deckCards       DeckCard[]
}

model Deck {
  id          String     @id @default(cuid())
  name        String
  format      String     @default("commander")  // commander is the v1 first-class format
  commanderId String?                            // FK to Card.id, primary commander
  partnerId   String?                            // FK to Card.id, partner / background slot
  // Cached snapshot of validation violations from src/lib/commander/rules.ts.
  // JSON array of { kind, ...payload, severity }; empty array = legal deck.
  violationsJson String  @default("[]")
  // Per-deck Commander rules config (see src/lib/commander/config.ts).
  // JSON shape: { deckSize, singleton, colorIdentity, banlist,
  //   commanderLegality, globalMode? } where each rule is "off" | "warn" | "block".
  // Missing rows use DEFAULT_CONFIG.
  rulesConfigJson String @default("{}")
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  cards       DeckCard[]
}

model DeckCard {
  deckId   String
  cardId   String
  quantity Int    @default(1)

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id])

  @@id([deckId, cardId])
  @@index([deckId])
}
