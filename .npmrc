# Package-manager hardening. pnpm reads this file; npm would too but
# `preinstall` refuses npm entirely (see scripts/check-package-manager.mjs).

# Don't ping the registry for vulnerability audits as part of install.
# Audit is run explicitly via `pnpm audit` when we want it.
audit=false

# Don't auto-update notification spam.
update-notifier=false

# Strict peer-dep handling: warn instead of silently mis-resolving.
strict-peer-dependencies=false
auto-install-peers=true

# Prevent accidental publish from a developer machine.
# (No-op for app projects but cheap defense-in-depth.)
access=restricted
